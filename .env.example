# ─── Application ──────────────────────────────────────────────────────────────
# No required env vars for local development.
# This file documents variables that can be set in production.

# Node environment
NODE_ENV=development

# Server port (used by `next start`)
PORT=3000

# ─── Feature Flags ───────────────────────────────────────────────────────────
# SSE push interval in milliseconds (default: 5000)
# FLIGHTS_STREAM_INTERVAL_MS=5000
